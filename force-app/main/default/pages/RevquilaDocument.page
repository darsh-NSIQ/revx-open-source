<apex:page controller="RevquilaDocumentController"
  renderAs="pdf"
  applyHtmlTag="false"
  applyBodyTag="false"
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
>
  <!--
    One generated quote or invoice, as a PDF. Opened with ?id=<Document_Snapshot__c id>.
    The PDF renderer understands CSS 2.1 only: tables for layout, no flex or grid.
    It also needs strictly valid markup. Conditions are written with apex:variable because
    an apex:outputPanel that is not rendered still leaves a hidden span behind, and a span
    inside a table row makes PDF generation fail.
    Colours, page size and font come from the controller, which only returns checked values.
  -->
  <html>
    <head>
      <style type="text/css">
        @page {
          size: {!paper};
          margin: 14mm 14mm 18mm 14mm;
          @bottom-right {
            content: "Page " counter(page) " of " counter(pages);
            font-family: {!fontFamily};
            font-size: 8pt;
            color: #5d6675;
          }
        }
        body {
          margin: 0;
          font-family: {!fontFamily};
          font-size: 9pt;
          line-height: 1.4;
          color: #1b1f27;
        }
        table {
          width: 100%;
          border-collapse: collapse;
        }
        td, th {
          vertical-align: top;
          text-align: left;
        }
        h1, h4, p {
          margin: 0;
        }
        h4 {
          margin-bottom: 3pt;
          font-size: 7.5pt;
          letter-spacing: 1pt;
          text-transform: uppercase;
          color: #5d6675;
        }
        .muted {
          color: #5d6675;
        }
        .strong {
          font-weight: bold;
        }
        .num {
          text-align: right;
          white-space: nowrap;
        }
        .watermark {
          /* behind the text: a positioned element is otherwise painted over it */
          position: fixed;
          z-index: -1;
          top: 105mm;
          left: 0;
          width: 100%;
          text-align: center;
          font-size: 96pt;
          font-weight: bold;
          letter-spacing: 8pt;
          color: #eff0f2;
        }
        .head {
          border-bottom: 1.5pt solid {!accent};
        }
        .head td {
          padding-bottom: 12pt;
        }
        .logo {
          margin-bottom: 7pt;
        }
        .company {
          font-size: 10.5pt;
          font-weight: bold;
        }
        .title {
          text-align: right;
        }
        .title.left {
          text-align: left;
        }
        .brand.right {
          text-align: right;
        }
        .title h1 {
          font-size: 21pt;
          line-height: 1.1;
          text-transform: uppercase;
          color: {!accent};
        }
        .docno {
          margin-top: 3pt;
          font-size: 10pt;
          font-weight: bold;
        }
        .parties {
          margin-top: 18pt;
        }
        .customer {
          font-size: 10.5pt;
          font-weight: bold;
        }
        .meta td {
          padding: 1.5pt 0;
        }
        .meta td.value {
          text-align: right;
          font-weight: bold;
        }
        .lines {
          margin-top: 18pt;
        }
        .lines th {
          padding: 6pt 7pt;
          font-weight: bold;
          color: #ffffff;
          background-color: {!accent};
        }
        .lines td {
          padding: 6pt 7pt;
          border-bottom: 0.5pt solid #d5d9e0;
        }
        .lines th.num {
          text-align: right;
        }
        .unit {
          font-size: 8pt;
          color: #5d6675;
        }
        .sums {
          margin-top: 14pt;
          page-break-inside: avoid;
        }
        .totals td {
          padding: 2pt 7pt;
        }
        .totals td.value {
          text-align: right;
          font-weight: bold;
        }
        .totals tr.grand td {
          padding: 6pt 7pt;
          font-size: 10.5pt;
          font-weight: bold;
          color: #1b1f27;
          background-color: {!accentSoft};
        }
        .foot {
          margin-top: 26pt;
          border-top: 0.5pt solid #d5d9e0;
          font-size: 8.3pt;
          color: #5d6675;
          page-break-inside: avoid;
        }
        .foot td {
          padding-top: 10pt;
        }
        .gap {
          margin-top: 9pt;
        }
        .sign {
          text-align: right;
          vertical-align: bottom;
        }
        .signline {
          height: 36pt;
          margin-bottom: 3pt;
          border-bottom: 0.5pt solid #1b1f27;
        }
        .signatory {
          font-weight: bold;
          color: #1b1f27;
        }
        .footer {
          margin-top: 16pt;
          text-align: center;
          font-size: 8.3pt;
          color: #5d6675;
        }

        /* modern: a band of the accent colour across the top */
        .layout-modern .head {
          border-bottom: 0;
          background-color: {!accent};
        }
        .layout-modern .head td {
          padding: 14pt;
          color: #ffffff;
        }
        .layout-modern .head .muted,
        .layout-modern .title h1 {
          color: #ffffff;
        }
        .layout-modern .logo img {
          padding: 3pt 5pt;
          background-color: #ffffff;
        }
        .layout-modern .lines th {
          color: {!accent};
          background-color: {!accentSoft};
        }
        .layout-modern .totals tr.grand td {
          color: #ffffff;
          background-color: {!accent};
        }

        /* minimal: rules only, no fills */
        .layout-minimal .head {
          border-bottom: 0.5pt solid #1b1f27;
        }
        .layout-minimal .title h1 {
          font-size: 13pt;
          letter-spacing: 3pt;
          color: #1b1f27;
        }
        .layout-minimal .lines th {
          color: #1b1f27;
          background-color: #ffffff;
          border-bottom: 0.5pt solid #1b1f27;
        }
        .layout-minimal .totals tr.grand td {
          background-color: #ffffff;
          border-top: 0.5pt solid #1b1f27;
          border-bottom: 0.5pt solid #1b1f27;
        }
      </style>
    </head>
    <body class="layout-{!layout}">
      <apex:variable var="shown" value="" rendered="{!missing}">
        <p>
          This document is not available. It may have been generated by someone
          else, or the link is incomplete. Open the quote or invoice in RevX
          and generate the PDF again.
        </p>
      </apex:variable>

      <apex:variable var="shown" value="" rendered="{!found}">
        <apex:variable var="shown" value="" rendered="{!hasWatermark}">
          <div class="watermark">{!model.watermark}</div>
        </apex:variable>

        <table class="head">
          <tr>
            <apex:variable var="shown" value="" rendered="{!logoOnRight}">
              <td class="title left">
                <h1>{!model.title}</h1>
                <div class="docno">{!model.documentNumber}</div>
              </td>
            </apex:variable>
            <td class="brand {!IF(logoOnRight, 'right', '')}">
              <apex:variable var="shown" value="" rendered="{!customLogo}">
                <div class="logo">
                  <img src="{!model.logoUrl}" height="40" alt="" />
                </div>
              </apex:variable>
              <apex:variable var="shown" value="" rendered="{!defaultLogo}">
                <div class="logo">
                  <img
                    src="{!URLFOR($Resource.revquilaLogo)}"
                    height="40"
                    alt=""
                  />
                </div>
              </apex:variable>
              <div class="company">{!model.companyName}</div>
              <apex:repeat value="{!model.companyLines}" var="line">
                <div class="muted">{!line}</div>
              </apex:repeat>
              <div class="muted">{!model.companyRegistration}</div>
            </td>
            <apex:variable var="shown" value="" rendered="{!logoOnLeft}">
              <td class="title">
                <h1>{!model.title}</h1>
                <div class="docno">{!model.documentNumber}</div>
              </td>
            </apex:variable>
          </tr>
        </table>

        <table class="parties">
          <tr>
            <td style="width: 54%; padding-right: 18pt">
              <h4>Bill to</h4>
              <div class="customer">{!model.customerName}</div>
              <apex:repeat value="{!model.customerLines}" var="line">
                <div class="muted">{!line}</div>
              </apex:repeat>
              <div class="muted">{!model.customerRegistration}</div>
            </td>
            <td>
              <table class="meta">
                <apex:repeat value="{!model.meta}" var="row">
                  <tr>
                    <td class="muted">{!row.label}</td>
                    <td class="value">{!row.value}</td>
                  </tr>
                </apex:repeat>
              </table>
            </td>
          </tr>
        </table>

        <table class="lines">
          <thead>
            <tr>
              <th style="width: 16pt">#</th>
              <th>Description</th>
              <th class="num">Qty</th>
              <th class="num">{!model.priceHeading}</th>
              <apex:variable var="shown"
                value=""
                rendered="{!model.showDiscount}"
              >
                <th class="num">Disc.</th>
              </apex:variable>
              <th class="num">{!model.amountHeading}</th>
            </tr>
          </thead>
          <tbody>
            <apex:repeat value="{!model.rows}" var="row">
              <tr>
                <td class="muted">{!row.no}</td>
                <td>
                  {!row.name}
                  <apex:variable var="shown"
                    value=""
                    rendered="{!model.showUnit}"
                  >
                    <div class="unit">{!row.unit}</div>
                  </apex:variable>
                </td>
                <td class="num">{!row.qty}</td>
                <td class="num">{!row.price}</td>
                <apex:variable var="shown"
                  value=""
                  rendered="{!model.showDiscount}"
                >
                  <td class="num">{!row.discount}</td>
                </apex:variable>
                <td class="num">{!row.amount}</td>
              </tr>
            </apex:repeat>
          </tbody>
        </table>

        <table class="sums">
          <tr>
            <td style="width: 50%; padding-right: 18pt">
              <apex:variable var="shown" value="" rendered="{!hasNotes}">
                <h4>Notes</h4>
                <apex:repeat value="{!model.notesLines}" var="line">
                  <div>{!line}</div>
                </apex:repeat>
              </apex:variable>
            </td>
            <td>
              <table class="totals">
                <apex:repeat value="{!model.totals}" var="row">
                  <tr>
                    <td class="muted">{!row.label}</td>
                    <td class="value">{!row.value}</td>
                  </tr>
                </apex:repeat>
                <tr class="grand">
                  <td>{!model.totalLabel}</td>
                  <td class="value">{!model.totalValue}</td>
                </tr>
                <apex:repeat value="{!model.settled}" var="row">
                  <tr>
                    <td class="muted">{!row.label}</td>
                    <td class="value">{!row.value}</td>
                  </tr>
                </apex:repeat>
              </table>
            </td>
          </tr>
        </table>

        <table class="foot">
          <tr>
            <td style="width: 62%; padding-right: 18pt">
              <apex:variable var="shown" value="" rendered="{!hasTerms}">
                <h4>Terms</h4>
                <apex:repeat value="{!model.termsLines}" var="line">
                  <div>{!line}</div>
                </apex:repeat>
              </apex:variable>
              <apex:variable var="shown" value="" rendered="{!hasBank}">
                <h4 class="gap">Bank details</h4>
                <apex:repeat value="{!model.bankLines}" var="line">
                  <div>{!line}</div>
                </apex:repeat>
              </apex:variable>
            </td>
            <td class="sign">
              <apex:variable var="shown" value="" rendered="{!hasSignatory}">
                <div>For {!model.companyName}</div>
                <div class="signline"></div>
                <div class="signatory">{!model.signatory}</div>
              </apex:variable>
            </td>
          </tr>
        </table>

        <div class="footer">{!model.footer}</div>
      </apex:variable>
    </body>
  </html>
</apex:page>