<apex:page controller="RevquilaPortalController" showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" title="RevX Customer Portal - Invoice">
  <html>
    <head>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{!companyName}</title>
      <style type="text/css">
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Segoe UI", -apple-system, Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.5; color: #181c25; background: #f2f6fb; }
        .rq-top { padding: 22px 24px; color: #ffffff; background: linear-gradient(135deg, #10233f, {!accent}); }
        .rq-top h1 { margin: 4px 0 0; font-size: 26px; letter-spacing: -0.02em; }
        .rq-top small { opacity: 0.8; letter-spacing: 0.1em; text-transform: uppercase; font-size: 11.5px; font-weight: 600; }
        .rq-wrap { padding: 20px 24px 40px; display: flex; flex-direction: column; gap: 16px; }
        .rq-card { padding: 18px; border-radius: 16px; background: #ffffff; box-shadow: 0 0 0 1px #dde3ee, 0 8px 24px rgba(16, 35, 63, 0.08); }
        .rq-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
        .rq-fact { padding: 10px 12px; border-radius: 12px; background: #f4f7fb; }
        .rq-fact span { display: block; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #5c6678; }
        .rq-fact b { font-size: 16px; }
        table { width: 100%; border-collapse: collapse; }
        th { padding: 8px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #5c6678; text-align: left; }
        td { padding: 10px 8px; border-top: 1px solid #e3e8f0; vertical-align: top; }
        .num { text-align: right; white-space: nowrap; }
        td small { display: block; color: #5c6678; font-size: 12px; }
        .rq-totals { margin-left: auto; width: min(100%, 360px); }
        .rq-totals div { display: flex; justify-content: space-between; padding: 4px 0; }
        .rq-totals .grand { margin-top: 6px; padding-top: 10px; border-top: 1px solid #e3e8f0; font-size: 18px; font-weight: 800; }
        .rq-btn { display: inline-block; padding: 12px 18px; border: 0; border-radius: 12px; font-size: 15px; font-weight: 700; color: #ffffff; background: {!accent}; text-decoration: none; cursor: pointer; }
        .rq-form { display: flex; flex-direction: column; gap: 10px; max-width: 460px; }
        .rq-form input[type=text], .rq-form input[type=email] { width: 100%; padding: 10px 12px; border: 1px solid #d5dbe6; border-radius: 10px; font: inherit; }
        .rq-note { padding: 10px 12px; border-radius: 10px; font-weight: 600; background: #e8f4ec; color: #2e844a; }
        .rq-warn { background: #fff4e5; color: #a96404; }
        .rq-list a { color: {!accent}; font-weight: 700; text-decoration: none; }
        .rq-row { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-top: 1px solid #e3e8f0; }
        .rq-row:first-child { border-top: 0; }
        .tone-bad { color: #ba0517; }
        pre { white-space: pre-wrap; font-family: inherit; margin: 0; }
        @media (max-width: 560px) { .rq-hide { display: none; } }
      </style>
    </head>
    <body>
      <apex:variable var="v" value="" rendered="{!NOT(found)}">
        <div class="rq-top"><small>{!companyName}</small><h1>This link has expired</h1></div>
        <div class="rq-wrap"><div class="rq-card">The link is incomplete or no longer active. Ask {!companyName} for a new one.</div></div>
      </apex:variable>
      <apex:variable var="v" value="" rendered="{!found}">
        <div class="rq-top"><small>{!companyName} · {!title}</small><h1>{!docNumber}</h1><div>{!accountName}</div></div>
        <div class="rq-wrap">
          <div class="rq-card rq-facts">
            <apex:repeat value="{!facts}" var="f"><div class="rq-fact"><span>{!f.label}</span><b>{!f.value}</b></div></apex:repeat>
          </div>
          <div class="rq-card">
            <table>
              <thead><tr><th>Item</th><th class="num">Qty</th><th class="num rq-hide">Price</th><th class="num rq-hide">Disc.</th><th class="num">Amount</th></tr></thead>
              <tbody>
                <apex:repeat value="{!lines}" var="l">
                  <tr><td>{!l.name}<small>{!l.unit}</small></td><td class="num">{!l.qty}</td><td class="num rq-hide">{!l.price}</td><td class="num rq-hide">{!l.discount}</td><td class="num">{!l.net}</td></tr>
                </apex:repeat>
              </tbody>
            </table>
            <div class="rq-totals">
              <apex:repeat value="{!totals}" var="t"><div class="{!t.tone}"><span>{!t.label}</span><span>{!t.value}</span></div></apex:repeat>
            </div>
          </div>
          <apex:variable var="v" value="" rendered="{!NOT(ISBLANK(notes))}"><div class="rq-card"><pre>{!notes}</pre></div></apex:variable>
          <!-- Payment Success Banner -->
          <apex:variable var="v" value="" rendered="{!OR(paymentSuccess, status == 'Paid')}">
            <div class="rq-card" style="border-left: 4px solid #2e844a; background: #f0fdf4;">
              <div style="display: flex; align-items: center; gap: 14px;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: #2e844a; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: bold; flex-shrink: 0;">✓</div>
                <div>
                  <h3 style="margin: 0; color: #166534; font-size: 18px;">Payment Confirmed</h3>
                  <p style="margin: 4px 0 0; color: #15803d; font-size: 14px;">
                    This invoice is settled in full. Thank you for your business! Your digital receipt is recorded.
                  </p>
                </div>
              </div>
            </div>
          </apex:variable>

          <!-- Online Payment Card (When Unpaid and canPay is true) -->
          <apex:variable var="v" value="" rendered="{!AND(status != 'Paid', NOT(paymentSuccess), canPay)}">
            <div class="rq-card" style="border-top: 3px solid {!accent};">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                <div>
                  <h2 style="margin: 0; font-size: 20px; color: #181c25;">Online Checkout</h2>
                  <p style="margin: 4px 0 0; color: #5c6678; font-size: 14px;">
                    Pay instantly via Credit / Debit Card, UPI, Netbanking, or Wallets.
                  </p>
                </div>
                <div style="text-align: right;">
                  <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #5c6678; display: block; font-weight: 600;">Amount Due</span>
                  <span style="font-size: 24px; font-weight: 800; color: #10233f;">{!balanceFormatted}</span>
                </div>
              </div>

              <!-- Pay Action -->
              <apex:form >
                <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                  <apex:commandButton value="Pay Now ({!balanceFormatted}) →" action="{!payOnline}" styleClass="rq-btn" style="padding: 14px 28px; font-size: 16px; box-shadow: 0 4px 14px rgba(1, 118, 211, 0.3); cursor: pointer;" />
                  <span style="font-size: 12.5px; color: #5c6678; display: flex; align-items: center; gap: 6px;">
                    🔒 256-bit encrypted secure checkout via {!IF(gatewayName == 'stripe', 'Stripe', IF(gatewayName == 'razorpay', 'Razorpay', 'Payment Gateway'))}
                  </span>
                </div>
              </apex:form>

              <apex:variable var="v" value="" rendered="{!NOT(ISBLANK(paymentErrorMessage))}">
                <p class="rq-note rq-warn" style="margin-top: 14px;">{!paymentErrorMessage}</p>
              </apex:variable>

              <!-- Optional Bank Wire -->
              <apex:variable var="v" value="" rendered="{!NOT(ISBLANK(bankDetails))}">
                <div style="margin-top: 20px; padding-top: 16px; border-top: 1px dashed #e3e8f0;">
                  <h4 style="margin: 0 0 8px; font-size: 12.5px; color: #5c6678; text-transform: uppercase; letter-spacing: 0.06em;">Or pay via Direct Bank Transfer:</h4>
                  <pre style="background: #f8fafc; padding: 12px; border-radius: 8px; font-size: 13px; border: 1px solid #edf2f7;">{!bankDetails}</pre>
                </div>
              </apex:variable>
            </div>
          </apex:variable>

          <!-- Offline Bank Details (When canPay is false and status is not Paid) -->
          <apex:variable var="v" value="" rendered="{!AND(status != 'Paid', NOT(paymentSuccess), NOT(canPay))}">
            <div class="rq-card">
              <h3 style="margin-top:0">How to pay</h3>
              <apex:variable var="v" value="" rendered="{!NOT(ISBLANK(bankDetails))}"><pre>{!bankDetails}</pre></apex:variable>
              <apex:variable var="v" value="" rendered="{!ISBLANK(bankDetails)}"><p>Contact {!companyName} for payment details.</p></apex:variable>
            </div>
          </apex:variable>
        </div>
      </apex:variable>
    </body>
  </html>
</apex:page>